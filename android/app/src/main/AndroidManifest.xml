<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.NFC" />
    <!--
        RECORD_AUDIO removed for V1. The `record` package is commented out of
        pubspec.yaml (AGP 8 incompatible) and no microphone API is called
        anywhere in lib/, so this permission requested mic access for a
        capability the binary does not contain. Restore alongside
        ZendFeatures.dmVoiceNotes when a compatible recorder lands.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!--
        Zend Drop is gated off for V1 (see ZendFeatures.drop). With the gate
        closed, DropDiscoverabilityService.init() is never called, so
        _isDiscoverable stays false and pause() early-returns; every remaining
        call site is inside an `if (ZendFeatures.drop)`. No BLE API is
        reachable, which means the permissions below were being requested for
        a feature no user can open.

        That is not just dead weight on the Data Safety form. ACCESS_FINE_LOCATION
        and FOREGROUND_SERVICE_CONNECTED_DEVICE each trigger their own Play
        Console declaration requiring written justification and a demo video,
        and reviewers reject justifications they cannot reproduce in the build.

        Restore all of the following, plus the .DropAdvertiserService <service>
        declaration below, when ZendFeatures.drop is flipped back on:

          BLUETOOTH            (maxSdkVersion=30)
          BLUETOOTH_ADMIN      (maxSdkVersion=30)
          BLUETOOTH_SCAN       (usesPermissionFlags=neverForLocation, tools:targetApi="s")
          BLUETOOTH_ADVERTISE
          BLUETOOTH_CONNECT
          ACCESS_FINE_LOCATION      — BLE scanning on Android <= 11
          ACCESS_COARSE_LOCATION    — BLE scanning on Android <= 11
          FOREGROUND_SERVICE
          FOREGROUND_SERVICE_CONNECTED_DEVICE
          WAKE_LOCK                 — keeps the BLE stack alive while advertising
          -->
    <!-- Post notifications — required on Android 13+ (API 33+) for system notification bar alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Contacts access — used to find which contacts are registered on Zend -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <application
        android:label="Zend! App"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Android App Links: zdfi.me/u/@* deep links open ZendApp directly -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zdfi.me" android:pathPrefix="/u/" />
            </intent-filter>

            <!-- Android App Links: zdfi.me/@{tag} payment QR links -->
            <!-- No autoVerify — prevents OS from intercepting URLs decoded by the
                 in-app QR scanner. Deep links from browsers still work because
                 Android offers the app as a handler via the chooser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zdfi.me" android:pathPrefix="/@" />
            </intent-filter>

            <!-- Custom URI scheme fallback: zendapp://pay?zendtag=john_o&amount=10 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zendapp" android:host="pay" />
            </intent-filter>
        </activity>

        <!-- zkLogin OAuth callback (flutter_web_auth_2).
             Two filters on purpose:
               1. https App Link — Google only permits https redirect URIs for a
                  Web OAuth client, and the Web client is what keeps the zkLogin
                  address identical across app and web (`aud` feeds the address).
               2. zendapp://auth-callback — a fallback for when App Link
                  verification has not propagated, so a failed domain
                  verification degrades to a chooser instead of a dead sign-in.
             taskAffinity is cleared per flutter_web_auth_2 5.x guidance. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter android:label="flutter_web_auth_2" android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zdfi.me" android:path="/auth/callback" />
            </intent-filter>
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zendapp" android:host="auth-callback" />
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!--
            Zend Drop foreground service, removed for V1 along with the BLE
            permissions above (see ZendFeatures.drop). Declaring a
            connectedDevice foreground service obliges us to justify it in the
            Play Console; the Kotlin class is still in the tree, so restoring
            this is just un-commenting:

            <service
                android:name=".DropAdvertiserService"
                android:foregroundServiceType="connectedDevice"
                android:exported="false" />
        -->
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: allow opening https URLs in browser -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
